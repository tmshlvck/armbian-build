From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Frank Wunderlich <frank-w@public-files.de>
Date: Thu, 4 Dec 2025 00:00:00 +0000
Subject: [PATCH] mt76: add support for loading EEPROM from filesystem

Add mt76_get_eeprom_file() function to load EEPROM data from
/lib/firmware/mediatek/{driver_name}_rf.bin as a fallback when
device tree or MTD sources are not available.

This is useful for PCIe WiFi cards that lack onboard EEPROM chips,
such as certain MT7615E development boards.

Original patch by Frank Wunderlich, adapted for kernel 6.16.

Signed-off-by: Frank Wunderlich <frank-w@public-files.de>
---
 drivers/net/wireless/mediatek/mt76/eeprom.c | 50 ++++++++++++++++++++-
 1 file changed, 49 insertions(+), 1 deletion(-)

diff --git a/drivers/net/wireless/mediatek/mt76/eeprom.c b/drivers/net/wireless/mediatek/mt76/eeprom.c
index 111111111111..222222222222 100644
--- a/drivers/net/wireless/mediatek/mt76/eeprom.c
+++ b/drivers/net/wireless/mediatek/mt76/eeprom.c
@@ -10,6 +10,53 @@
 #include <linux/etherdevice.h>
 #include "mt76.h"

+static int
+mt76_get_eeprom_file(struct mt76_dev *dev, int len)
+{
+	char path[64] = "";
+	struct file *fp;
+	loff_t pos = 0;
+	int ret;
+	struct inode *inode = NULL;
+	loff_t size;
+
+	ret = snprintf(path, sizeof(path), "/lib/firmware/mediatek/%s_rf.bin",
+		       dev->dev->driver->name);
+	if (ret < 0)
+		return -EINVAL;
+
+	dev_info(dev->dev, "Load eeprom: %s\n", path);
+	fp = filp_open(path, O_RDONLY, 0);
+	if (IS_ERR(fp)) {
+		dev_info(dev->dev, "Open eeprom file failed: %s\n", path);
+		return -ENOENT;
+	}
+
+	inode = file_inode(fp);
+	if ((!S_ISREG(inode->i_mode) && !S_ISBLK(inode->i_mode))) {
+		dev_err(dev->dev, "invalid file type: %s\n", path);
+		filp_close(fp, 0);
+		return -ENOENT;
+	}
+
+	size = i_size_read(inode->i_mapping->host);
+	if (size < 0) {
+		dev_err(dev->dev, "failed getting size of %s size:%lld\n", path, size);
+		filp_close(fp, 0);
+		return -ENOENT;
+	}
+
+	ret = kernel_read(fp, dev->eeprom.data, len, &pos);
+	filp_close(fp, 0);
+	if (ret < size) {
+		dev_info(dev->dev, "Load eeprom ERR, count %d byte (len:%d)\n", ret, len);
+		return -ENOENT;
+	}
+
+	dev_info(dev->dev, "Load eeprom OK, count %d byte\n", ret);
+	return 0;
+}
+
 static int mt76_get_of_eeprom_data(struct mt76_dev *dev, void *eep, int len)
 {
 	struct device_node *np = dev->dev->of_node;
@@ -418,6 +465,7 @@ mt76_eeprom_init(struct mt76_dev *dev, int len)
 	if (!dev->eeprom.data)
 		return -ENOMEM;

-	return !mt76_get_of_eeprom(dev, dev->eeprom.data, len);
+	return (!mt76_get_eeprom_file(dev, len)) ||
+	       (!mt76_get_of_eeprom(dev, dev->eeprom.data, len));
 }
 EXPORT_SYMBOL_GPL(mt76_eeprom_init);
--
