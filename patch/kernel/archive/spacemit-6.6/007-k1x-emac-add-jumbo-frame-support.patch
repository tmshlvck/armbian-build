From: Tomas Hlavacek <tmshlvck@gmail.com>
Subject: [PATCH] net: k1x-emac: fix jumbo frame support

The k1x-emac driver allows changing MTU up to 4K via emac_change_mtu()
and allocates appropriately sized DMA buffers, but it never programs
the MAC frame size and jabber registers.

This causes the MAC hardware to reject frames larger than the default
1518 bytes, even when larger buffers are allocated. Frames exceeding
the default size trigger EMAC_RX_FRAME_JABBER_ERR and are discarded.

Fix this by:
1. Programming MAC_MAXIMUM_FRAME_SIZE, MAC_TRANSMIT_JABBER_SIZE, and
   MAC_RECEIVE_JABBER_SIZE in emac_init_hw() based on the configured MTU
2. Setting ndev->max_mtu in probe to allow MTU changes up to buffer limit
3. Fixing the maximum buffer size from 4096 to 4095, since the descriptor
   buffer size field is only 12 bits
4. Accounting for double VLAN tags in frame size calculations

Based on the mainline k1_emac fix submitted to LKML.

Signed-off-by: Tomas Hlavacek <tmshlvck@gmail.com>
---
 drivers/net/ethernet/spacemit/k1x-emac.c | 22 ++++++++++++++++++++--
 drivers/net/ethernet/spacemit/k1x-emac.h |  2 ++
 2 files changed, 22 insertions(+), 2 deletions(-)

--- a/drivers/net/ethernet/spacemit/k1x-emac.c
+++ b/drivers/net/ethernet/spacemit/k1x-emac.c
@@ -14,6 +14,7 @@
 #include <linux/etherdevice.h>
 #include <linux/ethtool.h>
 #include <linux/dma-direct.h>
+#include <linux/if_vlan.h>
 #include <linux/in.h>
 #include <linux/interrupt.h>
 #include <linux/io.h>
@@ -277,6 +278,7 @@
 int emac_init_hw(struct emac_priv *priv)
 {
 	u32 val = 0;
+	u32 frame_sz;

 	emac_enable_axi_single_id_mode(priv, 1);

@@ -301,6 +303,15 @@

 	emac_wr(priv, MAC_RECEIVE_PACKET_START_THRESHOLD, priv->rx_threshold);

+	/* Set maximum frame size and jabber size based on configured MTU,
+	 * accounting for Ethernet header, double VLAN tags, and FCS.
+	 */
+	frame_sz = priv->ndev->mtu + ETHERNET_HEADER_SIZE + 2 * VLAN_HLEN + ETHERNET_FCS_SIZE;
+
+	emac_wr(priv, MAC_MAXIMUM_FRAME_SIZE, frame_sz);
+	emac_wr(priv, MAC_TRANSMIT_JABBER_SIZE, frame_sz);
+	emac_wr(priv, MAC_RECEIVE_JABBER_SIZE, frame_sz);
+
 	/* set emac rx mitigation frame count */
 	val = EMAC_RX_FRAMES & MREGBIT_RECEIVE_IRQ_FRAME_COUNTER_MSK;

@@ -1817,10 +1828,10 @@
 		return -EBUSY;
 	}

-	frame_len = mtu + ETHERNET_HEADER_SIZE + ETHERNET_FCS_SIZE;
+	frame_len = mtu + ETHERNET_HEADER_SIZE + 2 * VLAN_HLEN + ETHERNET_FCS_SIZE;

 	if (frame_len < MINIMUM_ETHERNET_FRAME_SIZE ||
-		frame_len > EMAC_RX_BUF_4K) {
+		frame_len > EMAC_RX_BUF_MAX) {
 			pr_err("Invalid MTU setting\n");
 			return -EINVAL;
 	}
@@ -2659,6 +2670,9 @@

 	ndev->hw_features = NETIF_F_SG;
 	ndev->features |= ndev->hw_features;
+
+	/* Allow MTU up to max buffer size minus ethernet overhead with VLAN headroom */
+	ndev->max_mtu = EMAC_RX_BUF_MAX - ETHERNET_HEADER_SIZE - 2 * VLAN_HLEN - ETHERNET_FCS_SIZE;
 	priv = netdev_priv(ndev);
 	priv->ndev = ndev;
 	priv->pdev = pdev;
--- a/drivers/net/ethernet/spacemit/k1x-emac.h
+++ b/drivers/net/ethernet/spacemit/k1x-emac.h
@@ -427,6 +427,8 @@
 #define EMAC_DEFAULT_BUFSIZE				1536
 #define EMAC_RX_BUF_2K					2048
 #define EMAC_RX_BUF_4K					4096
+/* Maximum buffer size limited by 12-bit descriptor field (0xFFF = 4095) */
+#define EMAC_RX_BUF_MAX					4095

 #define MAX_DATA_PWR_TX_DES				11
 #define MAX_DATA_LEN_TX_DES				2048 //2048=1<<11
